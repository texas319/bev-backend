  <String Id="HelpText" Value="/install | /repair | /uninstall | /layout [directory] - installs, repairs, uninstalls or creates a local copy. /passive | /quiet - displays minimal or no UI. /norestart - suppresses any restarts. /log log.txt - logs to a file." />
