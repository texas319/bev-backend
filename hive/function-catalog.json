{
  "catalog_version": "1.1",
  "date": "2026-06-04",
  "owner": "NEXUS Team",
  "principle": "Every remote-callable method NEXUS or EAGLE exposes. Pairs with BEV Panel Registry.json (the read plane). Functions are the WRITE / CONTROL plane.",
  "invoke_envelope": {
    "function_id": "string  (matches an id below)",
    "args": "object  (per the function's args schema)",
    "request_id": "string  (server-assigned, echoed in response)",
    "actor": "string  (dashboard email from JWT \u2014 server stamps, not client)",
    "ts_utc": "ISO-8601 string"
  },
  "ack_envelope": {
    "request_id": "string",
    "function_id": "string",
    "status": "ok | error | pending",
    "result": "object | null",
    "error": "string | null",
    "ts_utc": "ISO-8601 string"
  },
  "tiers": {
    "read": "no state change \u2014 anyone entitled to the fleet can call",
    "write": "mutates per-account state \u2014 entitled + audit-logged",
    "nuclear": "halts/flattens at scale \u2014 entitled + explicit confirm step + audit + announcement frame to all subscribers"
  },
  "audit": "EVERY non-read invocation writes a row to the EAGLE audit log (PART 37 P37_LogEvent) AND the Server audit pipeline. The actor email is non-falsifiable (server-stamped from JWT).",
  "scoping": {
    "rule": "Args containing an account or fleet_id are checked against the JWT's fleet_ids on every call \u2014 out-of-scope = 403, no execution.",
    "nuclear_extra": "Nuclear-tier calls require args.confirm == true AND a second confirm round-trip (server replies status=pending with a confirm_token; client repeats the call with confirm_token)."
  },
